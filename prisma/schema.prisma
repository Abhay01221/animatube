// Prisma schema for Animatube (Prisma 7)
// Connection URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth required tables ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  firebaseUid   String?   @unique // ← ADDED (Firebase Authentication UID)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  googleId      String?   @unique

  // AES-256 encrypted YouTube OAuth tokens (JSON blob)
  youtubeTokens String? @db.Text

  // User preferences stored as JSON
  settings Json?

  // Usage limits
  credits         Int @default(5)
  videosGenerated Int @default(0)

  accounts Account[]
  sessions Session[]
  videos   Video[]

  createdAt DateTime @default(now())
}

model Video {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  jobId  String @unique
  
  // Legacy status field (kept for backward compatibility)
  status String @default("pending") // pending | processing | completed | failed

  // New granular status fields
  renderStatus String @default("pending") // pending | processing | completed | failed
  uploadStatus String @default("not_started") // not_started | queued | uploading | uploaded | failed
  subtitlesAdded Boolean @default(false)

  prompt     String @db.Text
  style      String
  duration   String
  voice      String
  language   String
  visibility String @default("private")

  // Populated after script generation
  scriptJson  Json?
  title       String?
  description String? @db.Text
  tags        String[]

  // Cinematic enhancements
  storyPlan   Json? // StoryPlan structure
  scenes      Json? // CinematicScene[] array
  characters  Json? // CharacterDescription[] array
  storyboard  Json? // Storyboard preview data

  // Local file storage
  localFilePath String? // Path to final MP4 in local library

  // S3 keys (optional cloud storage)
  s3VoiceUrl    String?
  s3VideoUrl    String? // final_video.mp4
  s3RawVideoUrl String? // raw_video.mp4 (before subtitles)

  // Supabase Storage public URL for the final rendered video
  videoUrl      String? // permanent public URL (Supabase Storage)

  // YouTube upload (completely optional)
  youtubeId    String?
  youtubeUrl   String?
  thumbnailUrl String?

  // Error tracking (separate for render vs upload)
  renderError String? @db.Text
  uploadError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
